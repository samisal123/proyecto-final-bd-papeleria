digraph MR_papeleria {
  // Modelo relacional del sistema de papelerías (notación pata de gallo)
  // PK llave primaria, FK llave foránea, U única, N acepta nulos, C calculado,
  // CK restricción check, D discriminante de la jerarquía de productos.
  // Se dibuja con: dot -Tpdf mr_papeleria.dot -o mr_papeleria.pdf
  graph [rankdir=LR, nodesep=0.35, ranksep=1.1, bgcolor="white", pad=0.3];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [dir=both, arrowtail=teetee, penwidth=1.1, arrowsize=0.9];

  codigo_postal [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>codigo_postal</b></td></tr><tr><td port="cp" align="left"><u>cp</u></td><td align="left"><font color="#52514e">char(5)</font></td><td port="cp_r" align="left"><font color="#52514e">PK</font></td></tr><tr><td port="estado" align="left">estado</td><td align="left"><font color="#52514e">varchar(40)</font></td><td port="estado_r" align="left"> </td></tr></table>>];
  proveedor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>proveedor</b></td></tr><tr><td port="id_proveedor" align="left"><u>id_proveedor</u></td><td align="left"><font color="#52514e">int</font></td><td port="id_proveedor_r" align="left"><font color="#52514e">PK</font></td></tr><tr><td port="razon_social" align="left">razon_social</td><td align="left"><font color="#52514e">varchar(120)</font></td><td port="razon_social_r" align="left"><font color="#52514e">U</font></td></tr><tr><td port="nombre" align="left">nombre</td><td align="left"><font color="#52514e">varchar(80)</font></td><td port="nombre_r" align="left"> </td></tr><tr><td port="cp" align="left">cp</td><td align="left"><font color="#52514e">char(5)</font></td><td port="cp_r" align="left"><font color="#52514e">FK</font></td></tr><tr><td port="colonia" align="left">colonia</td><td align="left"><font color="#52514e">varchar(60)</font></td><td port="colonia_r" align="left"> </td></tr><tr><td port="calle" align="left">calle</td><td align="left"><font color="#52514e">varchar(80)</font></td><td port="calle_r" align="left"> </td></tr><tr><td port="numero" align="left">numero</td><td align="left"><font color="#52514e">varchar(10)</font></td><td port="numero_r" align="left"> </td></tr></table>>];
  telefono_proveedor [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>telefono_proveedor</b></td></tr><tr><td port="id_proveedor" align="left"><u>id_proveedor</u></td><td align="left"><font color="#52514e">int</font></td><td port="id_proveedor_r" align="left"><font color="#52514e">PK, FK</font></td></tr><tr><td port="telefono" align="left"><u>telefono</u></td><td align="left"><font color="#52514e">varchar(10)</font></td><td port="telefono_r" align="left"><font color="#52514e">PK, CK</font></td></tr></table>>];
  cliente [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>cliente</b></td></tr><tr><td port="rfc" align="left"><u>rfc</u></td><td align="left"><font color="#52514e">varchar(13)</font></td><td port="rfc_r" align="left"><font color="#52514e">PK, CK</font></td></tr><tr><td port="nombre" align="left">nombre</td><td align="left"><font color="#52514e">varchar(80)</font></td><td port="nombre_r" align="left"> </td></tr><tr><td port="ap_paterno" align="left">ap_paterno</td><td align="left"><font color="#52514e">varchar(50)</font></td><td port="ap_paterno_r" align="left"><font color="#52514e">N</font></td></tr><tr><td port="ap_materno" align="left">ap_materno</td><td align="left"><font color="#52514e">varchar(50)</font></td><td port="ap_materno_r" align="left"><font color="#52514e">N</font></td></tr><tr><td port="cp" align="left">cp</td><td align="left"><font color="#52514e">char(5)</font></td><td port="cp_r" align="left"><font color="#52514e">FK</font></td></tr><tr><td port="colonia" align="left">colonia</td><td align="left"><font color="#52514e">varchar(60)</font></td><td port="colonia_r" align="left"> </td></tr><tr><td port="calle" align="left">calle</td><td align="left"><font color="#52514e">varchar(80)</font></td><td port="calle_r" align="left"> </td></tr><tr><td port="numero" align="left">numero</td><td align="left"><font color="#52514e">varchar(10)</font></td><td port="numero_r" align="left"> </td></tr></table>>];
  email_cliente [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>email_cliente</b></td></tr><tr><td port="rfc" align="left"><u>rfc</u></td><td align="left"><font color="#52514e">varchar(13)</font></td><td port="rfc_r" align="left"><font color="#52514e">PK, FK</font></td></tr><tr><td port="email" align="left"><u>email</u></td><td align="left"><font color="#52514e">varchar(100)</font></td><td port="email_r" align="left"><font color="#52514e">PK, CK</font></td></tr></table>>];
  producto [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>producto</b></td></tr><tr><td port="codigo_barras" align="left"><u>codigo_barras</u></td><td align="left"><font color="#52514e">varchar(13)</font></td><td port="codigo_barras_r" align="left"><font color="#52514e">PK, CK</font></td></tr><tr><td port="nombre" align="left">nombre</td><td align="left"><font color="#52514e">varchar(60)</font></td><td port="nombre_r" align="left"> </td></tr><tr><td port="marca" align="left">marca</td><td align="left"><font color="#52514e">varchar(40)</font></td><td port="marca_r" align="left"> </td></tr><tr><td port="descripcion" align="left">descripcion</td><td align="left"><font color="#52514e">varchar(150)</font></td><td port="descripcion_r" align="left"> </td></tr><tr><td port="tipo" align="left">tipo</td><td align="left"><font color="#52514e">varchar(10)</font></td><td port="tipo_r" align="left"><font color="#52514e">D, CK</font></td></tr><tr><td port="precio_venta" align="left">precio_venta</td><td align="left"><font color="#52514e">numeric(10,2)</font></td><td port="precio_venta_r" align="left"><font color="#52514e">CK</font></td></tr><tr><td port="precio_compra" align="left">precio_compra</td><td align="left"><font color="#52514e">numeric(10,2)</font></td><td port="precio_compra_r" align="left"><font color="#52514e">CK</font></td></tr><tr><td port="foto" align="left">foto</td><td align="left"><font color="#52514e">varchar(200)</font></td><td port="foto_r" align="left"> </td></tr><tr><td port="fecha_compra" align="left">fecha_compra</td><td align="left"><font color="#52514e">date</font></td><td port="fecha_compra_r" align="left"> </td></tr><tr><td port="stock" align="left">stock</td><td align="left"><font color="#52514e">int</font></td><td port="stock_r" align="left"><font color="#52514e">CK</font></td></tr><tr><td port="id_proveedor" align="left">id_proveedor</td><td align="left"><font color="#52514e">int</font></td><td port="id_proveedor_r" align="left"><font color="#52514e">FK</font></td></tr></table>>];
  venta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>venta</b></td></tr><tr><td port="num_venta" align="left"><u>num_venta</u></td><td align="left"><font color="#52514e">varchar(12)</font></td><td port="num_venta_r" align="left"><font color="#52514e">PK, CK</font></td></tr><tr><td port="fecha_venta" align="left">fecha_venta</td><td align="left"><font color="#52514e">date</font></td><td port="fecha_venta_r" align="left"> </td></tr><tr><td port="total_venta" align="left">total_venta</td><td align="left"><font color="#52514e">numeric(12,2)</font></td><td port="total_venta_r" align="left"><font color="#52514e">C, CK</font></td></tr><tr><td port="rfc_cliente" align="left">rfc_cliente</td><td align="left"><font color="#52514e">varchar(13)</font></td><td port="rfc_cliente_r" align="left"><font color="#52514e">FK</font></td></tr></table>>];
  detalle_venta [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#e9edf3" align="center"><b>detalle_venta</b></td></tr><tr><td port="num_venta" align="left"><u>num_venta</u></td><td align="left"><font color="#52514e">varchar(12)</font></td><td port="num_venta_r" align="left"><font color="#52514e">PK, FK</font></td></tr><tr><td port="codigo_barras" align="left"><u>codigo_barras</u></td><td align="left"><font color="#52514e">varchar(13)</font></td><td port="codigo_barras_r" align="left"><font color="#52514e">PK, FK</font></td></tr><tr><td port="cantidad" align="left">cantidad</td><td align="left"><font color="#52514e">int</font></td><td port="cantidad_r" align="left"><font color="#52514e">CK</font></td></tr><tr><td port="precio_unitario" align="left">precio_unitario</td><td align="left"><font color="#52514e">numeric(10,2)</font></td><td port="precio_unitario_r" align="left"> </td></tr><tr><td port="costo_unitario" align="left">costo_unitario</td><td align="left"><font color="#52514e">numeric(10,2)</font></td><td port="costo_unitario_r" align="left"> </td></tr><tr><td port="total_articulo" align="left">total_articulo</td><td align="left"><font color="#52514e">numeric(12,2)</font></td><td port="total_articulo_r" align="left"><font color="#52514e">C</font></td></tr></table>>];

  { rank=same; proveedor; cliente; }
  { rank=same; telefono_proveedor; email_cliente; producto; venta; }
  codigo_postal:cp_r:e -> proveedor:cp:w [arrowhead=crowodot];
  codigo_postal:cp_r:e -> cliente:cp:w [arrowhead=crowodot];
  proveedor:id_proveedor_r:e -> telefono_proveedor:id_proveedor:w [arrowhead=crowodot];
  proveedor:id_proveedor_r:e -> producto:id_proveedor:w [arrowhead=crowodot];
  cliente:rfc_r:e -> email_cliente:rfc:w [arrowhead=crowtee];
  cliente:rfc_r:e -> venta:rfc_cliente:w [arrowhead=crowodot];
  venta:num_venta_r:e -> detalle_venta:num_venta:w [arrowhead=crowtee];
  producto:codigo_barras_r:e -> detalle_venta:codigo_barras:w [arrowhead=crowodot];
}
